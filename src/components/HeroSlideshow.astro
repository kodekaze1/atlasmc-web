---
// Drop your Minecraft-render screenshots into /public/hero/ as slide-1.jpg,
// slide-2.jpg, slide-3.jpg, … (any image format works). Missing files are
// hidden gracefully via the onerror handler so the layout doesn't break
// during early development.
//
// Add slides by extending this list. Animation delays auto-stagger so the
// fade timing stays even no matter how many you add.

interface Slide {
  src: string;
  alt: string;
}

interface Props {
  slides?: Slide[];
}

const defaultSlides: Slide[] = [
  { src: '/hero/slide-1.jpg', alt: 'Minecraft cityscape generated from real-world OpenStreetMap data' },
  { src: '/hero/slide-2.jpg', alt: 'Minecraft urban environment with realistic terrain' },
  { src: '/hero/slide-3.jpg', alt: 'Minecraft city overlooking a river, generated by Atlasmc' },
];

const { slides = defaultSlides } = Astro.props;
const stagger = 21 / slides.length;
---
<div class="absolute inset-0 -z-10 overflow-hidden bg-[var(--color-bg)]">
  {/* Fallback grid background — visible if no slide images load. */}
  <div class="absolute inset-0 hero-grid pointer-events-none" aria-hidden="true"></div>

  {slides.map((slide, i) => (
    <img
      src={slide.src}
      alt={slide.alt}
      class="hero-slide absolute inset-0 w-full h-full object-cover"
      style={`animation-delay: ${(i * stagger).toFixed(2)}s;`}
      loading={i === 0 ? 'eager' : 'lazy'}
      decoding="async"
      onerror="this.style.display='none'"
    />
  ))}

  {/* Darken overlay so foreground text stays legible regardless of which slide is showing. */}
  <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/40 to-black/70 pointer-events-none"></div>
</div>
