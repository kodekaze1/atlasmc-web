---
const navItems = [
  { href: '/features', label: 'Features' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/download', label: 'Download' },
  { href: '/faq', label: 'FAQ' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---
<header class="border-b border-[var(--color-border)]/60 bg-black/40 backdrop-blur sticky top-0 z-20">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="logo-pixel text-2xl text-white hover:text-[var(--color-accent-bright)] transition">
      ATLASMC
    </a>
    <nav class="flex items-center gap-6">
      {navItems.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'text-sm transition hover:text-[var(--color-accent-bright)]',
            path === href ? 'text-[var(--color-accent-bright)]' : 'text-neutral-300',
          ]}
        >
          {label}
        </a>
      ))}
      <a
        href="https://github.com/kodekaze1/atlasmc"
        target="_blank"
        rel="noopener"
        class="text-sm border border-[var(--color-border)] rounded-md px-3 py-1.5 hover:border-[var(--color-accent)] hover:text-[var(--color-accent-bright)] transition"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>
