---
const year = new Date().getFullYear();

const productLinks = [
  { href: '/features', label: 'Features' },
  { href: '/download', label: 'Download' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/docs', label: 'Docs' },
];
const projectLinks = [
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/token', label: 'Token' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
];
const legalLinks = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/press', label: 'Press kit' },
  { href: 'https://github.com/kodekaze1/atlasmc/blob/main/NOTICE', label: 'NOTICE', external: true },
  { href: 'https://github.com/kodekaze1/atlasmc/blob/main/LICENSE', label: 'License', external: true },
];

// Social URLs — replace `#` with real URLs once accounts exist.
// Discord: create an "Atlasmc" server, get a permanent invite, paste here.
// Twitter/X: create @atlasmc (or whatever handle is free), paste profile URL.
const socials = [
  { name: 'GitHub', href: 'https://github.com/kodekaze1/atlasmc' },
  { name: 'Discord', href: '#' },
  { name: 'Twitter', href: '#' },
];
---
<footer class="border-t border-[var(--color-border)] mt-24">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
      <div class="col-span-2 md:col-span-1">
        <div class="logo-pixel-wordmark text-2xl mb-3">ATLASMC</div>
        <p class="text-sm text-neutral-400 leading-relaxed mb-4">
          Real-world locations in Minecraft. Open source, Apache 2.0.
        </p>
        <div class="flex gap-2">
          {socials.map(({ name, href }) => (
            <a
              href={href}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener' : undefined}
              aria-label={name}
              class="w-9 h-9 inline-flex items-center justify-center rounded-md border border-[var(--color-border)] text-neutral-400 hover:border-[var(--color-accent)] hover:text-[var(--color-accent-bright)] transition"
            >
              {name === 'GitHub' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .297a12 12 0 0 0-3.79 23.4c.6.111.82-.26.82-.577v-2.234c-3.338.726-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.835 2.81 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.466-1.334-5.466-5.93 0-1.31.467-2.382 1.236-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.323 3.3 1.23A11.5 11.5 0 0 1 12 5.803c1.02.005 2.047.137 3.006.404 2.29-1.553 3.297-1.23 3.297-1.23.654 1.653.243 2.873.12 3.176.77.84 1.234 1.911 1.234 3.22 0 4.61-2.806 5.624-5.479 5.92.43.372.823 1.102.823 2.222v3.293c0 .32.218.694.825.576A12 12 0 0 0 12 .297"/>
                </svg>
              )}
              {name === 'Discord' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.03zM8.02 15.331c-1.182 0-2.157-1.085-2.157-2.418 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.418 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.946 2.418-2.157 2.418z"/>
                </svg>
              )}
              {name === 'Twitter' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-500 mb-3">Product</h3>
        <ul class="space-y-2">
          {productLinks.map(({ href, label }) => (
            <li><a href={href} class="text-sm text-neutral-400 hover:text-[var(--color-accent-bright)] transition">{label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-500 mb-3">Project</h3>
        <ul class="space-y-2">
          {projectLinks.map(({ href, label }) => (
            <li><a href={href} class="text-sm text-neutral-400 hover:text-[var(--color-accent-bright)] transition">{label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-500 mb-3">Legal</h3>
        <ul class="space-y-2">
          {legalLinks.map(({ href, label, external }) => (
            <li>
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener' : undefined}
                class="text-sm text-neutral-400 hover:text-[var(--color-accent-bright)] transition"
              >{label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-[var(--color-border)] pt-6 text-sm text-neutral-400 space-y-2">
      <p>
        &copy; {year} Atlasmc &mdash; fork of
        <a href="https://github.com/louis-e/arnis" target="_blank" rel="noopener" class="underline hover:text-[var(--color-accent-bright)]">Arnis</a>
        by Louis Erbkamm. Licensed under Apache 2.0.
      </p>
      <p class="text-xs text-neutral-500">
        NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.
        &ldquo;Minecraft&rdquo; is a trademark of Mojang Synergies AB.
      </p>
    </div>
  </div>
</footer>
