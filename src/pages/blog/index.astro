---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
---
<BaseLayout
  title="Blog — Atlasmc"
  description="Release notes and project updates from Atlasmc."
>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-10">
    <p class="inline-block text-xs font-medium tracking-widest uppercase text-[var(--color-accent-bright)] mb-3">
      Blog
    </p>
    <h1 class="text-4xl font-bold tracking-tight">Release notes &amp; project updates.</h1>
    <p class="mt-5 text-lg text-neutral-300 leading-relaxed">
      What we shipped, what we&rsquo;re thinking about, and the occasional
      deeper note on how Atlasmc actually works.
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-20 space-y-4">
    {posts.length === 0 ? (
      <p class="text-neutral-400">No posts yet.</p>
    ) : (
      posts.map(post => (
        <a
          href={`/blog/${post.id}`}
          class="block group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 hover:border-[var(--color-accent)] transition"
        >
          <div class="flex items-baseline justify-between gap-4 flex-wrap mb-2">
            <h2 class="text-xl font-semibold group-hover:text-[var(--color-accent-bright)] transition">{post.data.title}</h2>
            <time class="text-xs text-neutral-500 font-mono">{dateFmt.format(post.data.pubDate)}</time>
          </div>
          <p class="text-sm text-neutral-300 leading-relaxed">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="mt-3 flex gap-2 flex-wrap">
              {post.data.tags.map(tag => (
                <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded bg-[var(--color-bg)] text-neutral-400 border border-[var(--color-border)]">{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))
    )}
  </section>
</BaseLayout>
