---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

const features = [
  {
    title: 'Java + Bedrock',
    body: 'Generate worlds for Minecraft Java Edition (1.17+) and Bedrock Edition. Bedrock output is a .mcworld file you can import on Windows, iOS, Android, or Minecraft Education.',
  },
  {
    title: 'Real-world geography',
    body: 'OpenStreetMap data drives buildings, roads, landuse, water, railways, and more. ESA WorldCover satellite data fills in realistic ground textures.',
  },
  {
    title: 'Multi-source elevation',
    body: 'AWS Terrain Tiles for global coverage, supplemented by USGS 3DEP (United States), IGN France, IGN España, and GSI Japan for high-resolution regional elevation.',
  },
  {
    title: 'Deterministic',
    body: 'Identical inputs produce identical worlds. Reproducible generation for sharing, education, and research.',
  },
  {
    title: '18 languages',
    body: 'GUI translated into English, German, Spanish, French, Polish, Russian, Chinese, Japanese, Korean, Portuguese, Arabic, and more.',
  },
  {
    title: 'Open source',
    body: 'Apache 2.0. Fork it, modify it, redistribute it. The full source for the desktop app is on GitHub.',
  },
];
---
<BaseLayout>
  <!-- Pre-launch announcement bar -->
  <a
    href="/token"
    class="block bg-gradient-to-r from-[var(--color-accent)]/15 via-[var(--color-accent)]/25 to-[var(--color-accent)]/15 border-b border-[var(--color-accent)]/30 py-2.5 text-center text-sm hover:from-[var(--color-accent)]/25 hover:via-[var(--color-accent)]/35 hover:to-[var(--color-accent)]/25 transition"
  >
    <span class="inline-flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent-bright)] animate-pulse"></span>
      <span class="text-[var(--color-accent-bright)] font-medium">Token launch incoming</span>
      <span class="text-neutral-300">— read the plan and get notified</span>
      <span class="text-[var(--color-accent-bright)]">→</span>
    </span>
  </a>

  <!-- Hero with slideshow background -->
  <section class="relative min-h-[88vh] flex items-center overflow-hidden">
    <HeroVideo />
    <div class="relative max-w-3xl mx-auto px-6 py-24 text-center">
      <div class="inline-block rounded-2xl border border-white/10 bg-black/45 backdrop-blur-sm px-8 py-10 md:px-12 md:py-14 shadow-2xl">
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.05] text-white">
          Bring the Real World into <span class="text-[var(--color-accent-bright)]">Minecraft</span>
        </h1>
        <p class="mt-5 text-base md:text-lg text-neutral-200">
          Transform any location on Earth into a playable Minecraft world.
          Free, open source, and easy to use.
        </p>
        <div class="mt-8 flex items-center justify-center gap-3 flex-wrap">
          <a
            href="/download"
            class="inline-flex items-center px-6 py-3 rounded-md bg-[var(--color-accent)] text-neutral-950 font-medium hover:bg-[var(--color-accent-bright)] transition"
          >
            Download for Free
          </a>
          <a
            href="https://github.com/kodekaze1/atlasmc"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center px-6 py-3 rounded-md border border-white/30 text-white hover:border-[var(--color-accent)] hover:text-[var(--color-accent-bright)] transition"
          >
            View on GitHub
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <a href="#features" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-neutral-300 text-sm flex flex-col items-center gap-1 hover:text-white transition">
      <span>Scroll to explore</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </a>
  </section>

  <!-- Features grid -->
  <section id="features" class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="text-3xl font-semibold tracking-tight mb-2">What it does</h2>
    <p class="text-neutral-400 mb-10">A full Rust desktop app — no servers, no accounts, no telemetry by default.</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map(({ title, body }) => (
        <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
          <h3 class="font-semibold text-[var(--color-accent-bright)] mb-2">{title}</h3>
          <p class="text-sm text-neutral-300 leading-relaxed">{body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Newsletter signup -->
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-semibold tracking-tight">Get notified at launch</h2>
      <p class="text-neutral-400 mt-2">No marketing emails — only token launch and major releases.</p>
    </div>
    <NewsletterSignup variant="card" />
  </section>

  <!-- Attribution / fork -->
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-8">
      <h2 class="text-2xl font-semibold tracking-tight mb-3">Built on Arnis</h2>
      <p class="text-neutral-300 leading-relaxed">
        Atlasmc is a fork of <a href="https://github.com/louis-e/arnis" target="_blank" rel="noopener" class="text-[var(--color-accent-bright)] underline">Arnis</a>
        by Louis Erbkamm and its 53+ contributors, licensed under Apache 2.0.
        We keep louis-e&rsquo;s copyright notice and credit upstream prominently in our
        <a href="https://github.com/kodekaze1/atlasmc/blob/main/NOTICE" target="_blank" rel="noopener" class="text-[var(--color-accent-bright)] underline">NOTICE</a> file.
        See <a href="/about" class="text-[var(--color-accent-bright)] underline">about</a> for the rationale and a summary of fork-specific changes.
      </p>
    </div>
  </section>
</BaseLayout>
